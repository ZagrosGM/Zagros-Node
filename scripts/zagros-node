#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# zagros-node — host CLI for a Zagros node (installed to /usr/local/bin).
#
# Container lifecycle is done here; anything that needs the agent's own view
# (certificate, inventory, pairing) is delegated into the container with
# `docker exec … python -m node_agent.cli`, so the host needs nothing but
# Docker and this file.
#
#   up | down | restart | status | logs | update | uninstall | cert | info
#   cores | exec | reset-registration | env | version | help
# ---------------------------------------------------------------------------
set -euo pipefail

DIR="${ZAGROS_NODE_DIR:-/opt/zagros-node}"
NAME="zagros-node"
IMAGE_DEFAULT="ghcr.io/zagrosgm/zagros-node:latest"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; C=$'\033[36m'; N=$'\033[0m'
else
  B=""; D=""; G=""; Y=""; R=""; C=""; N=""
fi
die() { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
warn(){ printf '%s!%s %s\n' "$Y" "$N" "$*" >&2; }

compose() {
  if docker compose version >/dev/null 2>&1; then
    ( cd "$DIR" && docker compose "$@" )
  else
    die "docker compose plugin is not installed"
  fi
}

require_install() { [ -d "$DIR" ] || die "no installation at $DIR (run the installer first)"; }
require_running() { docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null | grep -q true \
                      || die "the node is not running (start it with: zagros-node up)"; }

container_env() { # read one variable from the install .env
  [ -r "$DIR/.env" ] || return 0
  sed -n "s/^$1=//p" "$DIR/.env" | tail -1
}

in_container() { docker exec "$NAME" python -m node_agent.cli "$@"; }

usage() {
  cat <<'USAGE'
zagros-node <command> [args]

container
  up                     start (or create) the node container
  down                   stop and remove the container
  restart                restart the container
  status                 container + core lifecycle state
  logs [-f|--tail N]     agent logs (default: last 100 lines)
  exec <cmd…>            run a command inside the container

node
  info                   node id, pairing state, core inventory (JSON)
  cert                   certificate paths + the SHA-256 pin the panel pins
  cores                  installed cores and their lifecycle state
  reset-registration H   unpair and accept a new token (H = sha256 of it)

maintenance
  update [--image REF]   pull the current image and recreate the container
  uninstall [--purge]    stop and remove the node (--purge deletes data)
  env                    show the effective configuration
  version                agent version

USAGE
}

[ $# -ge 1 ] || { usage; exit 1; }
COMMAND="$1"; shift

case "$COMMAND" in
  # ---------------------------------------------------------------- container
  up)
    require_install
    compose up -d --remove-orphans
    echo "${G}✓${N} node started"
    ;;
  down)
    require_install
    compose down --remove-orphans
    echo "${G}✓${N} node stopped"
    ;;
  restart)
    require_install
    compose restart
    echo "${G}✓${N} node restarted"
    ;;
  status)
    require_install
    if docker inspect -f '{{.State.Running}}' "$NAME" >/dev/null 2>&1; then
      printf '%scontainer%s %s (%s)\n' "$B" "$N" "$NAME" \
        "$(docker inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null)"
      printf '%simage%s     %s\n' "$B" "$N" "$(docker inspect -f '{{.Config.Image}}' "$NAME" 2>/dev/null)"
    else
      warn "no container named $NAME"
    fi
    require_running
    in_container status || true
    ;;
  logs)
    require_install
    if [ "${1:-}" = "-f" ] || [ "${1:-}" = "--follow" ]; then
      docker logs -f "$NAME"
    elif [ "${1:-}" = "--tail" ]; then
      docker logs --tail "${2:-100}" "$NAME"
    else
      docker logs --tail 100 "$NAME"
    fi
    ;;
  exec)
    require_running
    docker exec -it "$NAME" "$@"
    ;;

  # -------------------------------------------------------------------- node
  info|cert|cores)
    require_running
    in_container "$COMMAND" "$@"
    ;;
  reset-registration)
    require_running
    HASH="${1:-}"
    [ -n "$HASH" ] || die "usage: zagros-node reset-registration <sha256-of-new-token>"
    in_container reset-registration "$HASH"
    echo "${G}✓${N} node unpaired — it will accept the next one-time token from a panel"
    ;;

  # ------------------------------------------------------------- maintenance
  update)
    require_install
    REF="${IMAGE_DEFAULT}"
    if [ "${1:-}" = "--image" ]; then REF="${2:?--image needs a reference}"; fi
    if [ -n "$(container_env ZAGROS_NODE_IMAGE)" ]; then
      REF="$(container_env ZAGROS_NODE_IMAGE)"
    fi
    echo "pulling $REF …"
    docker pull "$REF"
    sed -i.bak "s#^ZAGROS_NODE_IMAGE=.*#ZAGROS_NODE_IMAGE=$REF#" "$DIR/.env"
    compose up -d --remove-orphans
    echo "${G}✓${N} updated to $REF"
    ;;
  uninstall)
    PURGE=0
    [ "${1:-}" = "--purge" ] && PURGE=1
    require_install
    if [ "$PURGE" -eq 1 ]; then
      warn "--purge will delete ALL node data, including installed cores and their state"
      read -r -p "type 'purge' to continue: " CONFIRM
      [ "$CONFIRM" = "purge" ] || die "aborted"
    fi
    compose down --remove-orphans --volumes 2>/dev/null || true
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    if [ "$PURGE" -eq 1 ]; then
      docker image inspect "$NAME" >/dev/null 2>&1 && docker rmi -f "$NAME" >/dev/null 2>&1 || true
      rm -rf "${ZAGROS_NODE_HOST_DATA:-/var/lib/zagros}"
      rm -rf "$DIR"
      rm -f /usr/local/bin/zagros-node
      echo "${G}✓${N} node removed and all data purged"
    else
      echo "${G}✓${N} node stopped and removed (data kept at ${ZAGROS_NODE_HOST_DATA:-/var/lib/zagros})"
    fi
    ;;
  env)
    require_install
    cat "$DIR/.env" | sed 's/^\(ZAGROS_NODE_REGISTRATION_HASH=\).*/\1<sha256 — token is never stored>/'
    ;;
  version)
    if docker inspect -f '{{.State.Running}}' "$NAME" >/dev/null 2>&1; then
      in_container version
    else
      echo "zagros-node (agent not running)"
    fi
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    die "unknown command: $COMMAND (try: zagros-node help)"
    ;;
esac
