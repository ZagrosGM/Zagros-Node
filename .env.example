# ---------------------------------------------------------------------------
# Zagros Node configuration — written by install.sh into /opt/zagros-node/.env
# The image hardcodes nothing: edit this file, then `zagros-node restart`.
# ---------------------------------------------------------------------------

# --- identity ---------------------------------------------------------------
# Human-readable label shown in the panel (optional, defaults to the hostname).
ZAGROS_NODE_NAME=

# Comma-separated DNS names / IPs the panel uses to reach this node.
# They become certificate SANs — without them the panel's hostname
# verification fails, because a panel addresses nodes by IP.
ZAGROS_NODE_ADDRESS=

# --- listeners --------------------------------------------------------------
# HTTPS control plane: signed commands from the panel. Keep firewalled to the
# panel's address whenever possible.
ZAGROS_NODE_HOST=0.0.0.0
ZAGROS_NODE_PORT=62050

# Read-only bootstrap/info port: serves the node id, versions and the TLS
# certificate the panel pins. No secrets, ever. Lock it to the panel's IP with
# ZAGROS_NODE_INFO_BIND once pairing is done.
ZAGROS_NODE_API_PORT=62051
ZAGROS_NODE_INFO_BIND=0.0.0.0
# Publish the per-core inventory on /info too (off by default: mildly
# fingerprintable and unnecessary for pairing).
ZAGROS_NODE_INFO_DETAIL=0

# --- pairing ----------------------------------------------------------------
# SHA-256 of the ONE-TIME registration token (never the token itself). The
# panel generates the token, install.sh writes its hash here, and the hash is
# destroyed the moment pairing succeeds.
ZAGROS_NODE_REGISTRATION_HASH=

# --- image / updates --------------------------------------------------------
# `zagros-node update` pulls this exact reference and restarts.
ZAGROS_NODE_IMAGE=ghcr.io/zagrosgm/zagros-node:latest

# --- paths ------------------------------------------------------------------
# Everything persistent lives under one host directory mounted at
# /var/lib/zagros: .../node for identity+TLS+state, .../cores for the cores.
ZAGROS_NODE_DATA=/var/lib/zagros/node
